---
import T from "./T.astro";
import Icon from "./Icon.astro";
import { navItems } from "../data/nav";
import { socials, location, footerTech } from "../data/profile";

const year = new Date().getFullYear();
const heading = "mb-4 text-sm font-semibold uppercase tracking-wider text-text-primary";
const link = "inline-flex items-center gap-2.5 py-0.5 transition-colors hover:text-primary";
---

<footer class="bg-soft-bg pb-8 pt-12">
  <div class="container-x">

    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="flex flex-col gap-4">
        <span class="text-xl font-bold text-text-primary">Tun Sopheak</span>
        <p class="max-w-xs text-sm leading-relaxed text-text-secondary">
          <T
            en="Passionate about building scalable backend systems with Java, Spring Boot, and Python, turning ideas into reliable software with clean code and modern tools."
            km="ស្រឡាញ់ការសាងសង់ប្រព័ន្ធ backend ដែលអាចពង្រីកបាន ដោយប្រើ Java, Spring Boot និង Python បំប្លែងគំនិតទៅជាកម្មវិធីដែលអាចទុកចិត្តបាន ជាមួយកូដស្អាត និងឧបករណ៍ទំនើប។"
          />
        </p>
      </div>

      <!-- Quick links -->
      <nav aria-label="Footer">
        <h3 class={heading}><T en="Quick Links" km="តំណរហ័ស" /></h3>
        <ul class="space-y-2 text-sm text-text-secondary">
          {navItems.map((item) => (
            <li><a href={`/#${item.id}`} class={link}><T en={item.en} km={item.km} /></a></li>
          ))}
        </ul>
      </nav>

      <!-- Tech stack -->
      <div>
        <h3 class={heading}><T en="Tech Stack" km="បច្ចេកវិទ្យា" /></h3>
        <ul class="space-y-2 text-sm text-text-secondary">
          {footerTech.map((tech) => <li>{tech}</li>)}
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class={heading}><T en="Connect" km="ទំនាក់ទំនង" /></h3>
        <ul class="space-y-2 text-sm text-text-secondary">
          {socials.map((s) => (
            <li>
              <a href={s.href} target={s.id === "email" ? undefined : "_blank"} rel="noopener noreferrer" class={link}>
                <Icon name={s.icon} class="h-4 w-4 shrink-0" />{s.label}
              </a>
            </li>
          ))}
          <li>
            <a href={location.href} target="_blank" rel="noopener noreferrer" class={link}>
              <Icon name="pin" class="h-4 w-4 shrink-0" /><T en={location.en} km={location.km} />
            </a>
          </li>
        </ul>
      </div>
    </div>

        <div class="mt-12 flex flex-col items-center gap-2 pt-4 text-center">
      <p class="inline-flex items-center gap-2 text-sm font-medium text-text-secondary">
        <img src="/assets/images/khmer/flag-of-cambodia.svg" alt="" width="24" height="15" loading="lazy" class="flag-kh" />
        <T en="Made in Cambodia" km="ផលិតនៅកម្ពុជា" />
      </p>
      <p class="text-sm text-text-muted">&copy; {year} Tun Sopheak. <T en="All rights reserved." km="រក្សាសិទ្ធិគ្រប់យ៉ាង។" /></p>
    </div>
  </div>

</footer>
