---
import Icon from "./Icon.astro";
---

<!-- Behaviour (show after scrolling, smooth scroll) lives in scripts/ui.ts -->
<button
  id="back-to-top"
  type="button"
  data-show="false"
  data-aria-en="Back to top"
  data-aria-km="ត្រឡប់ឡើងលើ"
  aria-label="Back to top"
  class="fixed bottom-5 right-5 z-40 grid h-11 w-11 place-items-center rounded-full border border-primary/40 bg-surface text-primary shadow-lg transition duration-300 hover:scale-110 hover:border-primary md:bottom-8 md:right-8 pointer-events-none translate-y-3 opacity-0 data-[show=true]:pointer-events-auto data-[show=true]:translate-y-0 data-[show=true]:opacity-100"
>
  <Icon name="arrow-up" class="h-5 w-5" />
</button>
