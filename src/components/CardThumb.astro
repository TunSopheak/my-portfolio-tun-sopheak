---
// 16:10 thumbnail used by every card. A placeholder icon sits behind the image,
// so if the file is missing the image removes itself and the placeholder shows.
interface Props {
  src: string;
  alt: string;
  eager?: boolean;
  /** Set true and pass <span slot="badge"> to overlay a label in the top-right corner. */
  badge?: boolean;
}
const { src, alt, eager = false, badge = false } = Astro.props;
---

<div class="relative aspect-[16/10] shrink-0 overflow-hidden bg-primary/5">
  <div class="absolute inset-0 grid place-items-center text-primary/30" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
  </div>
  <img
    src={src}
    alt={alt}
    width="640"
    height="400"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="relative h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    onerror="this.remove()"
  />
  {badge && (
    <span class="absolute right-3 top-3 rounded-full bg-surface/90 px-2.5 py-1 text-[11px] font-semibold text-primary shadow-sm">
      <slot name="badge" />
    </span>
  )}
</div>
