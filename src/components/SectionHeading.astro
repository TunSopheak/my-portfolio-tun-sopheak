---
import T from "./T.astro";

interface Props {
  id?: string;
  en: string;
  km: string;
  subEn?: string;
  subKm?: string;
  as?: "h1" | "h2";
}
const { id, en, km, subEn, subKm, as: Tag = "h2" } = Astro.props;
---

<div class="mb-12 text-center reveal">
  <Tag id={id} class="inline-block text-3xl font-bold text-text-primary md:text-4xl">
    <T en={en} km={km} />
  </Tag>
  {subEn && (
    <p class="mx-auto mt-3 max-w-2xl text-base text-text-secondary">
      <T en={subEn} km={subKm} />
    </p>
  )}
</div>
