<!-- src/components/Header.astro -->

<header
  class="sticky top-0 z-40 bg-surface/80 backdrop-blur-xl shadow-sm transition-all duration-300 dark:border-b dark:border-border"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:py-5">
    
    <!-- Logo / Name -->
    <a
      href="/"
      class="text-xl md:text-2xl font-bold text-text-primary hover:text-primary transition-colors duration-200"
    >
      Tun Sopheak
    </a>

    <!-- Navigation & Controls -->
    <div class="flex items-center gap-4 md:gap-6">
      
      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-4 lg:gap-8">
        <li>
          <a
            href="/#hero"
            data-link="hero"
            class="group relative inline-block text-sm md:text-base font-medium text-text-secondary transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
          >
            Home
            <span
              class="absolute -bottom-1.5 left-0 h-[2px] w-0 bg-primary transition-all duration-300 group-hover:w-full data-[active=true]:w-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href="/#about"
            data-link="about"
            class="group relative inline-block text-sm md:text-base font-medium text-text-secondary transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
          >
            About
            <span
              class="absolute -bottom-1.5 left-0 h-[2px] w-0 bg-primary transition-all duration-300 group-hover:w-full data-[active=true]:w-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href="/#skills"
            data-link="skills"
            class="group relative inline-block text-sm md:text-base font-medium text-text-secondary transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
          >
            Skills
            <span
              class="absolute -bottom-1.5 left-0 h-[2px] w-0 bg-primary transition-all duration-300 group-hover:w-full data-[active=true]:w-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href="/#projects"
            data-link="projects"
            class="group relative inline-block text-sm md:text-base font-medium text-text-secondary transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
          >
            Projects
            <span
              class="absolute -bottom-1.5 left-0 h-[2px] w-0 bg-primary transition-all duration-300 group-hover:w-full data-[active=true]:w-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href="/#education"
            data-link="education"
            class="group relative inline-block text-sm md:text-base font-medium text-text-secondary transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
          >
            Education
            <span
              class="absolute -bottom-1.5 left-0 h-[2px] w-0 bg-primary transition-all duration-300 group-hover:w-full data-[active=true]:w-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href="/#activities"
            data-link="activities"
            class="group relative inline-block text-sm md:text-base font-medium text-text-secondary transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
          >
            Activities
            <span
              class="absolute -bottom-1.5 left-0 h-[2px] w-0 bg-primary transition-all duration-300 group-hover:w-full data-[active=true]:w-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href="/#achievements"
            data-link="achievements"
            class="group relative inline-block text-sm md:text-base font-medium text-text-secondary transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
          >
            Achievements
            <span
              class="absolute -bottom-1.5 left-0 h-[2px] w-0 bg-primary transition-all duration-300 group-hover:w-full data-[active=true]:w-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href="/#contact"
            data-link="contact"
            class="group relative inline-block text-sm md:text-base font-medium text-text-secondary transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
          >
            Contact
            <span
              class="absolute -bottom-1.5 left-0 h-[2px] w-0 bg-primary transition-all duration-300 group-hover:w-full data-[active=true]:w-full"
            ></span>
          </a>
        </li>
      </ul>

      <!-- Dark / Light Mode Toggle (Interactive) -->
      <button
        id="theme-toggle"
        type="button"
        class="relative p-2 rounded-full text-text-secondary hover:text-primary hover:bg-primary/10 transition-all duration-300 focus:outline-none group"
        aria-label="Toggle dark mode"
      >
        <svg
          id="theme-toggle-sun"
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 transition-all duration-500 group-hover:rotate-90 group-hover:scale-110"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>

        <svg
          id="theme-toggle-moon"
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-5 w-5 transition-all duration-500 group-hover:-rotate-90 group-hover:scale-110"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>

        <span class="absolute inset-0 rounded-full border-2 border-primary/0 transition-all duration-300 group-hover:border-primary/20"></span>
      </button>

      <!-- Hamburger Menu Button (Mobile) with SVG Icons -->
      <button
        id="menu-toggle"
        class="md:hidden relative flex items-center justify-center w-10 h-10 rounded-full hover:bg-primary/10 transition-all duration-300 focus:outline-none group"
        aria-label="Toggle menu"
      >
        <!-- List Icon (closed) -->
        <svg
          id="menu-icon-hamburger"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6 text-text-secondary transition-all duration-300 group-hover:text-primary group-hover:scale-110"
          fill="currentColor"
          viewBox="0 0 16 16"
        >
          <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
        </svg>

        <!-- X-Circle Icon (open) -->
        <svg
          id="menu-icon-close"
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-6 w-6 text-text-secondary transition-all duration-300 group-hover:text-primary group-hover:rotate-90 group-hover:scale-110"
          fill="currentColor"
          viewBox="0 0 16 16"
        >
          <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
          <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
        </svg>

        <span class="absolute inset-0 rounded-full border border-primary/0 transition-all duration-300 group-hover:border-primary/20"></span>
      </button>
    </div>

    <!-- Mobile Navigation Menu -->
    <div
      id="mobile-menu"
      class="md:hidden absolute top-full left-0 w-full bg-surface/95 dark:bg-surface-dark/95 backdrop-blur-md border-b border-white/10 dark:border-gray-700/30 shadow-2xl max-h-0 overflow-hidden transition-all duration-500 ease-out"
    >
      <div class="flex flex-col gap-1 p-4 pb-6">
        <a
          href="/#hero"
          data-link="hero"
          class="text-text-secondary hover:text-primary transition-all duration-300 text-sm font-medium px-3 py-2 rounded-lg hover:bg-primary/5 hover:pl-5"
        >
          Home
        </a>
        <a
          href="/#about"
          data-link="about"
          class="text-text-secondary hover:text-primary transition-all duration-300 text-sm font-medium px-3 py-2 rounded-lg hover:bg-primary/5 hover:pl-5"
        >
          About
        </a>
        <a
          href="/#skills"
          data-link="skills"
          class="text-text-secondary hover:text-primary transition-all duration-300 text-sm font-medium px-3 py-2 rounded-lg hover:bg-primary/5 hover:pl-5"
        >
          Skills
        </a>
        <a
          href="/#projects"
          data-link="projects"
          class="text-text-secondary hover:text-primary transition-all duration-300 text-sm font-medium px-3 py-2 rounded-lg hover:bg-primary/5 hover:pl-5"
        >
          Projects
        </a>
        <a
          href="/#education"
          data-link="education"
          class="text-text-secondary hover:text-primary transition-all duration-300 text-sm font-medium px-3 py-2 rounded-lg hover:bg-primary/5 hover:pl-5"
        >
          Education
        </a>
        <a
          href="/#activities"
          data-link="activities"
          class="text-text-secondary hover:text-primary transition-all duration-300 text-sm font-medium px-3 py-2 rounded-lg hover:bg-primary/5 hover:pl-5"
        >
          Activities
        </a>
        <a
          href="/#achievements"
          data-link="achievements"
          class="text-text-secondary hover:text-primary transition-all duration-300 text-sm font-medium px-3 py-2 rounded-lg hover:bg-primary/5 hover:pl-5"
        >
          Achievements
        </a>
        <a
          href="/#contact"
          data-link="contact"
          class="text-text-secondary hover:text-primary transition-all duration-300 text-sm font-medium px-3 py-2 rounded-lg hover:bg-primary/5 hover:pl-5"
        >
          Contact
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // ============================================
    // DARK / LIGHT MODE TOGGLE
    // ============================================
    const themeToggle = document.getElementById("theme-toggle") as HTMLButtonElement | null;
    const sunIcon = document.getElementById("theme-toggle-sun") as SVGElement | null;
    const moonIcon = document.getElementById("theme-toggle-moon") as SVGElement | null;

    if (themeToggle && sunIcon && moonIcon) {
      // Apply theme with explicit boolean type
      const applyTheme = (isDark: boolean) => {
        document.documentElement.classList.toggle("dark", isDark);
        sunIcon.classList.toggle("hidden", !isDark);
        moonIcon.classList.toggle("hidden", isDark);
        localStorage.setItem("theme", isDark ? "dark" : "light");
      };

      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDark = savedTheme === "dark" || (savedTheme === null && prefersDark);
      applyTheme(isDark);

      themeToggle.addEventListener("click", () => {
        const currentlyDark = document.documentElement.classList.contains("dark");
        applyTheme(!currentlyDark);
      });
    }

    // ============================================
    // MOBILE MENU TOGGLE – SVG Icon Swap
    // ============================================
    const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
    const menu = document.getElementById("mobile-menu") as HTMLDivElement | null;
    const hamburgerIcon = document.getElementById("menu-icon-hamburger") as SVGElement | null;
    const closeIcon = document.getElementById("menu-icon-close") as SVGElement | null;

    if (toggle && menu && hamburgerIcon && closeIcon) {
      let isOpen = false;

      const toggleMenu = () => {
        isOpen = !isOpen;
        menu.classList.toggle("max-h-0");
        menu.classList.toggle("max-h-[500px]");
        hamburgerIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
        toggle.classList.toggle("bg-primary/10");
        document.body.style.overflow = isOpen ? "hidden" : "";
      };

      toggle.addEventListener("click", toggleMenu);

      // Close menu when clicking a link
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          if (isOpen) toggleMenu();
        });
      });

      // Close menu on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen) toggleMenu();
      });
    }

    // ============================================
    // NAVIGATION – WORKS ON HOMEPAGE & DETAIL PAGES
    // ============================================
    const navLinks = document.querySelectorAll<HTMLAnchorElement>("nav ul li a[data-link]");
    const sections = document.querySelectorAll<HTMLElement>("section[id]");

    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const href = link.getAttribute("href");
        if (!href) return;
        const targetId = href.split("#")[1];
        if (!targetId) return;

        const targetSection = document.getElementById(targetId);

        if (targetSection) {
          targetSection.scrollIntoView({ behavior: "smooth" });
          if (window.history && window.history.replaceState) {
            window.history.replaceState(null, "", window.location.pathname);
          }
        } else {
          window.location.href = `/#${targetId}`;
        }
      });
    });

    // ============================================
    // SCROLL SPY – Highlights active section
    // ============================================
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => link.removeAttribute("data-active"));
            const id = entry.target.id;
            const activeLink = document.querySelector<HTMLAnchorElement>(
              `nav ul li a[data-link="${id}"]`
            );
            if (activeLink) {
              activeLink.setAttribute("data-active", "true");
            }
          }
        });
      },
      {
        rootMargin: "0px 0px -40% 0px",
        threshold: 0.1,
      }
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>