---
import T from "./T.astro";
import Icon from "./Icon.astro";
import { navItems } from "../data/nav";
---

<header id="site-header" class="sticky top-0 z-50 border-b border-border bg-surface/85 backdrop-blur-lg transition-shadow duration-300 data-[scrolled=true]:shadow-md">
  <nav class="container-x flex items-center justify-between gap-3 py-2.5 md:py-3" aria-label="Main">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2.5" aria-label="Tun Sopheak — home">
      <span class="h-10 w-10 shrink-0 overflow-hidden rounded-full ring-2 ring-primary/30 transition group-hover:ring-primary/60 md:h-11 md:w-11">
        <img src="/assets/images/logo.jpg" alt="" width="44" height="44" class="h-full w-full object-cover" />
      </span>
      <span class="text-lg font-bold text-text-primary transition-colors group-hover:text-primary md:text-xl">Tun Sopheak</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3 lg:gap-6">
      <!-- Desktop links -->
      <ul class="hidden items-center gap-5 lg:flex xl:gap-7">
        {navItems.map((item) => (
          <li>
            <a href={`/#${item.id}`} data-link={item.id} class="nav-link"><T en={item.en} km={item.km} /></a>
          </li>
        ))}
      </ul>

      <!-- Language switch -->
      <div class="lang-seg" role="group" aria-label="Language">
        <button type="button" data-set-lang="en" lang="en">EN</button>
        <button type="button" data-set-lang="km" lang="km">ខ្មែរ</button>
      </div>

      <!-- Theme -->
      <button
        type="button"
        data-theme-toggle
        data-aria-en="Toggle dark mode"
        data-aria-km="ប្តូរម៉ូដងងឹត/ភ្លឺ"
        aria-label="Toggle dark mode"
        class="grid h-10 w-10 place-items-center rounded-full text-text-secondary transition hover:bg-primary/10 hover:text-primary"
      >
        <Icon name="sun" class="hidden h-5 w-5 dark:block" />
        <Icon name="moon" class="h-5 w-5 dark:hidden" />
      </button>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-aria-en="Open menu"
        data-aria-km="បើកម៉ឺនុយ"
        aria-label="Open menu"
        class="grid h-10 w-10 place-items-center rounded-full text-text-secondary transition hover:bg-primary/10 hover:text-primary lg:hidden"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </nav>
</header>

<!-- Mobile menu: slides in from the right -->
<div id="mobile-overlay" data-open="false" class="fixed inset-0 z-[55] bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 lg:hidden"></div>

<aside
  id="mobile-menu"
  data-open="false"
  aria-label="Menu"
  class="invisible fixed right-0 top-0 z-[60] flex h-full w-[82%] max-w-xs translate-x-full flex-col border-l border-border bg-surface shadow-2xl transition-[transform,visibility] duration-300 ease-out data-[open=true]:visible data-[open=true]:translate-x-0 lg:hidden"
>
  <div class="flex items-center justify-between border-b border-border px-5 py-4">
    <span class="text-sm font-semibold tracking-wide text-text-muted"><T en="Menu" km="ម៉ឺនុយ" /></span>
    <button
      id="menu-close"
      type="button"
      data-aria-en="Close menu"
      data-aria-km="បិទម៉ឺនុយ"
      aria-label="Close menu"
      class="grid h-10 w-10 place-items-center rounded-full text-text-secondary transition hover:bg-primary/10 hover:text-primary"
    >
      <Icon name="close" class="h-6 w-6" />
    </button>
  </div>

  <ul class="flex-1 space-y-1 overflow-y-auto p-3">
    {navItems.map((item) => (
      <li>
        <a
          href={`/#${item.id}`}
          data-link={item.id}
          class="mobile-link flex min-h-12 items-center justify-between rounded-xl px-4 text-base font-medium text-text-secondary transition hover:bg-primary/10 hover:text-primary data-[active=true]:bg-primary/10 data-[active=true]:text-primary"
        >
          <T en={item.en} km={item.km} />
          <Icon name="chevron" class="h-4 w-4 opacity-50" />
        </a>
      </li>
    ))}
  </ul>
</aside>

<script>
  // Mobile menu + scroll-spy. (Theme, language, back-to-top: scripts/ui.ts)
  const menu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("mobile-overlay");
  const openBtn = document.getElementById("menu-toggle");
  const closeBtn = document.getElementById("menu-close");

  function setMenu(open: boolean): void {
    menu?.setAttribute("data-open", String(open));
    overlay?.setAttribute("data-open", String(open));
    openBtn?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
    if (open) closeBtn?.focus();
    else if (document.activeElement && menu?.contains(document.activeElement)) openBtn?.focus();
  }

  openBtn?.addEventListener("click", () => setMenu(true));
  closeBtn?.addEventListener("click", () => setMenu(false));
  overlay?.addEventListener("click", () => setMenu(false));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.getAttribute("data-open") === "true") setMenu(false);
  });
  // Rotating a phone / resizing to desktop must not leave the page scroll-locked
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });

  // Highlight the link of the section currently in view (home page only)
  const sections = document.querySelectorAll<HTMLElement>("main section[id]");
  if (sections.length && "IntersectionObserver" in window) {
    const links = document.querySelectorAll<HTMLElement>("[data-link]");
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            if (link.dataset.link === entry.target.id) link.setAttribute("data-active", "true");
            else link.removeAttribute("data-active");
          });
        }
      },
      // a section counts as "current" while it crosses the band 40–45% down the viewport
      { rootMargin: "-40% 0px -55% 0px" },
    );
    sections.forEach((s) => spy.observe(s));
  }
</script>
