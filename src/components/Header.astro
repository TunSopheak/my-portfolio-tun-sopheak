          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>

        <span
          class="absolute inset-0 rounded-full border-2 border-primary/0 transition-all duration-300 group-hover:border-primary/20"
        ></span>
      </button>

      <!-- Hamburger Menu Button (Mobile) - Now with z-50 to stay above menu -->
      <button
        id="menu-toggle"
        class="md:hidden relative flex items-center justify-center w-10 h-10 rounded-full hover:bg-primary/10 transition-all duration-300 focus:outline-none group z-50"
        aria-label="Toggle menu"
