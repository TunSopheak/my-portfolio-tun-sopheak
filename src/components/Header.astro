<!-- src/components/Header.astro -->
<header
  class="sticky top-0 z-10 bg-surface shadow-sm transition-colors duration-300 dark:border-b dark:border-border"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <!-- Logo / Name -->
    <a href="/" class="text-xl font-bold text-text-primary">Tun Sopheak</a>

    <!-- Navigation & Controls -->
    <div class="flex items-center space-x-6">
      <ul class="flex space-x-6">
        <li>
          <a
            href="/#hero"
            class="text-text-secondary hover:text-primary dark:hover:text-primary"
            >Home</a
          >
        </li>
        <li>
          <a
            href="/#about"
            class="text-text-secondary hover:text-primary dark:hover:text-primary"
            >About</a
          >
        </li>
        <li>
          <a
            href="/#skills"
            class="text-text-secondary hover:text-primary dark:hover:text-primary"
            >Skills</a
          >
        </li>
        <li>
          <a
            href="/#projects"
            class="text-text-secondary hover:text-primary dark:hover:text-primary"
            >Projects</a
          >
        </li>
        <li>
          <a
            href="/#education"
            class="text-text-secondary hover:text-primary dark:hover:text-primary"
            >Education</a
          >
        </li>
        <li>
          <a
            href="/#activities"
            class="text-text-secondary hover:text-primary dark:hover:text-primary"
            >Activities</a
          >
        </li>
        <li>
          <a
            href="/#achievements"
            class="text-text-secondary hover:text-primary dark:hover:text-primary"
            >Achievements</a
          >
        </li>
        <li>
          <a
            href="/#contact"
            class="text-text-secondary hover:text-primary dark:hover:text-primary"
            >Contact</a
          >
        </li>
      </ul>

      <!-- ============================================ -->
      <!-- LANGUAGE TOGGLE (with Globe Icon)            -->
      <!-- ============================================ -->
      <button
        id="lang-toggle"
        class="flex items-center gap-1.5 text-sm font-medium text-text-secondary hover:text-primary dark:hover:text-primary"
        aria-label="Toggle language"
      >
        <!-- Globe Icon - Simplified, uses currentColor -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path
            d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
          ></path>
        </svg>
        <!-- Language Label -->
        <span id="lang-label">EN</span>
      </button>

      <!-- ============================================ -->
      <!-- DARK MODE TOGGLE                             -->
      <!-- ============================================ -->
      <button
        id="theme-toggle"
        class="text-text-secondary hover:text-primary focus:outline-none dark:hover:text-primary"
        aria-label="Toggle dark mode"
      >
        <!-- Sun Icon -->
        <svg
          id="theme-toggle-sun"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>

        <!-- Moon Icon -->
        <svg
          id="theme-toggle-moon"
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // ============================================
    // 1. DARK MODE TOGGLE (WITH NULL CHECKS)
    // ============================================
    const themeToggle = document.getElementById("theme-toggle");
    const sunIcon = document.getElementById("theme-toggle-sun");
    const moonIcon = document.getElementById("theme-toggle-moon");

    // Check if icons exist before using them
    if (sunIcon && moonIcon) {
      const savedTheme = localStorage.getItem("theme");

      if (savedTheme === "dark") {
        document.documentElement.classList.add("dark");
        sunIcon.classList.remove("hidden");
        moonIcon.classList.add("hidden");
      } else {
        document.documentElement.classList.remove("dark");
        sunIcon.classList.add("hidden");
        moonIcon.classList.remove("hidden");
        if (!savedTheme) localStorage.setItem("theme", "light");
      }

      // Check if toggle button exists
      themeToggle?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        sunIcon.classList.toggle("hidden", !isDark);
        moonIcon.classList.toggle("hidden", isDark);
      });
    }

    // ============================================
    // 2. LANGUAGE TOGGLE (WITH NULL CHECKS)
    // ============================================
    const langToggle = document.getElementById("lang-toggle");
    const langLabel = document.getElementById("lang-label");

    // Check if label exists
    if (langLabel) {
      const savedLang = localStorage.getItem("lang") || "en";
      document.documentElement.lang = savedLang;
      langLabel.textContent = savedLang === "en" ? "EN" : "KH";
    }

    // Check if toggle button exists
    langToggle?.addEventListener("click", () => {
      const currentLang = document.documentElement.lang || "en";
      const newLang = currentLang === "en" ? "kh" : "en";
      document.documentElement.lang = newLang;
      localStorage.setItem("lang", newLang);
      if (langLabel) {
        langLabel.textContent = newLang === "en" ? "EN" : "KH";
      }
    });
  });
</script>
