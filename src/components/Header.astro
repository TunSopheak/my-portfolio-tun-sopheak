            alt="Tun Sopheak Logo"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
          />
        </div>
      </div>
      <span
        class="text-xl md:text-2xl font-bold text-text-primary group-hover:text-primary transition-colors duration-200"
      >
        Tun Sopheak
