          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-6 w-6 text-text-secondary transition-all duration-300 group-hover:text-primary group-hover:rotate-90 group-hover:scale-110"
          fill="currentColor"
          viewBox="0 0 16 16"
        >
          <path
            d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"
          ></path>
          <path
            d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"
          ></path>
        </svg>

        <span
          class="absolute inset-0 rounded-full border border-primary/0 transition-all duration-300 group-hover:border-primary/20"
        ></span>
      </button>
    </div>
