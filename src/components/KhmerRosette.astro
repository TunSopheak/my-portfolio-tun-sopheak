---
// Small four-petal lotus rosette (ផ្កា) used in section headings.
// Original artwork for this site — simplified from Angkorian lotus-rosette motifs.
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {[0, 90, 180, 270].map((deg) => (
    <path d="M12 12C9 9.5 9 5.5 12 2C15 5.5 15 9.5 12 12Z" transform={`rotate(${deg} 12 12)`} />
  ))}
  {[45, 135, 225, 315].map((deg) => (
    <path d="M12 12C10.8 11 10.8 9.2 12 7.5C13.2 9.2 13.2 11 12 12Z" transform={`rotate(${deg} 12 12)`} stroke-width="1" />
  ))}
  <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
</svg>
