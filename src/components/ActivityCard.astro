---
import T from "./T.astro";
import Icon from "./Icon.astro";
import CardThumb from "./CardThumb.astro";
import type { Activity } from "../data/types";

interface Props {
  activity: Activity;
  index?: number;
}
const { activity, index = 0 } = Astro.props;
const km = activity.km ?? {};
---

<article class="card group reveal flex flex-col overflow-hidden" style={`--d:${(index % 3) * 90}ms`}>
  <CardThumb src={activity.image} alt={activity.title} />

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div>
      <h3 class="text-xl font-bold leading-tight text-text-primary">
        <T en={activity.title} km={km.title} />
      </h3>
      <p class="mt-1 text-sm font-medium text-primary">{activity.year}</p>
    </div>

    <p class="flex-1 text-sm leading-relaxed text-text-secondary">
      <T en={activity.description} km={km.description} />
    </p>

    <div class="flex flex-wrap gap-2">
      {activity.tags.slice(0, 3).map((tag, i) => (
        <span class="chip"><T en={tag} km={km.tags?.[i]} /></span>
      ))}
    </div>

    <div class="mt-2 border-t border-border pt-4">
      <a href={`/activities/${activity.id}`} class="btn btn-primary group/btn">
        <T en="View Details" km="មើលលម្អិត" />
        <Icon name="arrow" class="h-4 w-4 transition-transform group-hover/btn:translate-x-1" />
      </a>
    </div>
  </div>
</article>
