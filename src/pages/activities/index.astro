---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ActivityCard from "../../components/ActivityCard.astro";
import { activities } from "../../data/activities";
---

<BaseLayout title="All Activities — Tun Sopheak" description="Leadership, volunteering and community activities of Tun Sopheak.">
  <section class="section min-h-screen bg-soft-bg">
    <div class="container-x">
      <BackLink href="/#activities" en="Back to Home" km="ត្រឡប់ទៅទំព័រដើម" />
      <SectionHeading
        as="h1"
        en="All Activities"
        km="សកម្មភាពទាំងអស់"
        subEn="A complete list of my extracurricular activities, leadership roles, and volunteer work."
        subKm="បញ្ជីពេញលេញនៃសកម្មភាពក្រៅម៉ោងសិក្សា តួនាទីដឹកនាំ និងការងារស្ម័គ្រចិត្តរបស់ខ្ញុំ។"
      />

      <div class="card-grid">
        {activities.map((activity, i) => <ActivityCard activity={activity} index={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>
