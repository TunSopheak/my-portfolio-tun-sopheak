---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";
import T from "../../components/T.astro";
import { activities } from "../../data/activities";

export function getStaticPaths() {
  return activities.map((activity) => ({ params: { id: activity.id }, props: { activity } }));
}

const { activity } = Astro.props;
const km = activity.km ?? {};
---

<BaseLayout title={`${activity.title} — Activities`} description={activity.description}>
  <section class="section min-h-screen bg-soft-bg">
    <div class="container-x max-w-4xl">
      <BackLink href="/activities/" en="Back to All Activities" km="ត្រឡប់ទៅសកម្មភាពទាំងអស់" />

      <header class="mb-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">{activity.year}</p>
        <h1 class="mt-2 text-3xl font-bold leading-tight text-text-primary md:text-5xl">
          <T en={activity.title} km={km.title} />
        </h1>
        <p class="mt-2 text-lg text-text-secondary"><T en={activity.type} km={km.type} /></p>
      </header>

      <div class="card relative overflow-hidden bg-primary/5">
        <img
          src={activity.image}
          alt={activity.title}
          width="1200"
          height="750"
          decoding="async"
          class="h-auto max-h-[520px] w-full object-cover"
          onerror="this.parentElement.style.minHeight='12rem'; this.remove()"
        />
      </div>

      {activity.images && activity.images.length > 0 && (
        <div class="mt-8">
          <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold text-text-primary">
            <T en="Gallery" km="វិចិត្រសាល" />
            <span class="text-xs font-normal text-text-muted">({activity.images.length})</span>
          </h2>
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
            {activity.images.map((img) => (
              <div class="card group overflow-hidden">
                <img src={img} alt={`${activity.title} photo`} loading="lazy" decoding="async" class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.parentElement.remove()" />
              </div>
            ))}
          </div>
        </div>
      )}

      {activity.details && (
        <div class="card mt-8 p-6 md:p-8">
          <h2 class="mb-4 flex items-center gap-3 text-xl font-semibold text-text-primary">
            <span class="h-6 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
            <T en="About This Activity" km="អំពីសកម្មភាពនេះ" />
          </h2>
          <p class="whitespace-pre-line leading-relaxed text-text-secondary">
            <T en={activity.details} km={km.details} />
          </p>
        </div>
      )}

      {activity.tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2.5">
          {activity.tags.map((tag, i) => (
            <span class="chip !px-3.5 !py-1.5 !text-sm"><T en={tag} km={km.tags?.[i]} /></span>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
