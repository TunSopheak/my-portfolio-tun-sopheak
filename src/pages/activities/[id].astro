---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { activities } from "../../data/activities";

export async function getStaticPaths() {
  return activities.map((activity) => ({
    params: { id: activity.id },
    props: { activity },
  }));
}

const { activity } = Astro.props;
---

<BaseLayout title={`${activity.title} — Activities`}>
  <section class="py-20 bg-soft-bg transition-colors duration-300">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      
      <!-- Back to All Activities -->
      <div class="flex items-center gap-1.5 mb-6 group">
        <a href="/activities" class="text-sm text-text-secondary hover:text-primary transition flex items-center gap-1">
          <span class="text-xl group-hover:-translate-x-1 transition-transform duration-200">←</span>
          Back to All Activities
        </a>
      </div>

      <!-- Header -->
      <div class="mb-8">
        <p class="text-sm font-semibold text-primary tracking-wide uppercase">{activity.year}</p>
        <h1 class="text-3xl md:text-5xl font-bold text-text-primary mt-2 leading-tight">{activity.title}</h1>
        <p class="text-text-secondary text-lg mt-2">{activity.type}</p>
      </div>

      <!-- Main Image -->
      <div class="rounded-2xl overflow-hidden shadow-xl border border-white/10 dark:border-gray-700/30">
        <img
          src={activity.image}
          alt={activity.title}
          class="w-full h-auto max-h-[500px] object-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
        />
        <div class="hidden w-full h-64 flex items-center justify-center text-primary/40 bg-white/5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
      </div>

      <!-- Gallery (Additional Images) -->
      {activity.images && activity.images.length > 0 && (
        <div class="mt-6">
          <h3 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span>Gallery</span>
            <span class="text-xs text-text-secondary/50 font-normal">({activity.images.length} photos)</span>
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {activity.images.map((img) => (
              <div class="rounded-xl overflow-hidden border border-white/10 dark:border-gray-700/30 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <img
                  src={img}
                  alt={`${activity.title} photo`}
                  class="w-full h-48 object-cover hover:scale-105 transition-transform duration-500"
                  onerror="this.style.display='none'"
                />
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Full Description -->
      {activity.details && (
        <div class="mt-8 bg-white/5 dark:bg-black/30 backdrop-blur-md border border-white/10 dark:border-gray-700/30 rounded-2xl p-6 md:p-8 shadow-xl">
          <h3 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-3">
            <span class="w-1.5 h-6 bg-primary rounded-full"></span>
            About This Activity
          </h3>
          <p class="text-text-secondary leading-relaxed whitespace-pre-line">
            {activity.details}
          </p>
        </div>
      )}

      <!-- Tags -->
      {activity.tags && activity.tags.length > 0 && (
        <div class="flex flex-wrap gap-2.5 mt-8">
          {activity.tags.map((tag) => (
            <span class="inline-flex items-center rounded-full bg-primary/10 px-3.5 py-1.5 text-sm font-medium text-primary ring-1 ring-inset ring-primary/20 hover:bg-primary/20 transition-colors duration-200">
              {tag}
            </span>
          ))}
        </div>
      )}

    </div>
  </section>
</BaseLayout>