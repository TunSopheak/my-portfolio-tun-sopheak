---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Tun Sopheak — Personal Developer Portfolio">
  <!-- ============================================ -->
  <!-- HERO SECTION                                 -->
  <!-- ============================================ -->
  <section id="hero" class="min-h-screen flex items-center py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- ===== LEFT COLUMN: TEXT ===== -->
        <div>
          <!-- Open to Work Badge -->
          <div class="flex justify-start mb-4">
            <span
              class="inline-flex items-center gap-2 bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300 px-4 py-1.5 rounded-full text-sm font-medium border border-green-300 dark:border-green-700"
            >
              <span class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"
              ></span>
              Open to Work
            </span>
          </div>

          <!-- Greeting -->
          <p class="text-lg text-text-secondary mb-1">Hello, I'm</p>

          <!-- Name -->
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary"
          >
            Tun Sopheak
          </h1>

          <!-- Typewriter Role -->
          <div class="mt-2">
            <span class="text-xl md:text-2xl font-medium text-primary">
              <span id="typed-role"></span>
              <span class="cursor-blink">|</span>
            </span>
          </div>

          <!-- Tagline -->
          <p
            class="text-base md:text-lg text-text-secondary mt-4 max-w-xl leading-relaxed"
          >
            Turning ideas into functional web applications with clean code,
            modern tools, and a focus on real-world impact.
          </p>

          <!-- Education / Location -->
          <p class="text-sm text-text-secondary mt-3">
            Computer Science Student at RUPP · Phnom Penh, Cambodia
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap gap-4 mt-7">
            <a
              href="#projects"
              class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-hover transition"
            >
              View Projects
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>

            <a
              href="/assets/files/Tun_Sopheak - Curriculum_Vitae - Full_Stack_Developer.pdf"
              download
              class="inline-flex items-center gap-2 border-2 border-primary text-primary dark:text-primary dark:border-primary px-6 py-3 rounded-lg font-medium hover:bg-primary/10 transition"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"></path>
              </svg>
              Download CV
            </a>
          </div>

          <!-- Social Icons -->
          <div class="flex items-center gap-6 mt-8">
            <!-- GitHub -->
            <a
              href="https://github.com/TunSopheak"
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-secondary hover:text-primary transition"
              aria-label="GitHub"
              title="GitHub"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-7 w-7"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57
                    0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41
                    -.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795
                    .945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305
                    3.495.99.105-.78.42-1.305.765-1.605
                    -2.67-.3-5.46-1.335-5.46-5.925
                    0-1.305.465-2.385 1.23-3.225
                    -.12-.3-.54-1.53.12-3.15 0 0 1.005-.315 3.3 1.23
                    .96-.27 1.98-.405 3-.405s2.04.135 3 .405
                    c2.295-1.56 3.3-1.23 3.3-1.23
                    .66 1.62.24 2.85.12 3.15
                    .765.84 1.23 1.905 1.23 3.225
                    0 4.605-2.805 5.625-5.475 5.925
                    .435.375.81 1.095.81 2.22
                    0 1.605-.015 2.895-.015 3.3
                    0 .315.225.69.825.57
                    A12.02 12.02 0 0024 12
                    c0-6.63-5.37-12-12-12z"
                ></path>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/in/tun-sopheak"
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-secondary hover:text-primary transition"
              aria-label="LinkedIn"
              title="LinkedIn"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-7 w-7"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037
                    -1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414
                    v1.561h.046c.477-.9 1.637-1.85 3.37-1.85
                    3.601 0 4.267 2.37 4.267 5.455v6.286z
                    M5.337 7.433c-1.144 0-2.063-.926-2.063-2.065
                    0-1.138.92-2.063 2.063-2.063
                    1.14 0 2.064.925 2.064 2.063
                    0 1.139-.925 2.065-2.064 2.065z
                    m1.782 13.019H3.555V9h3.564v11.452z
                    M22.225 0H1.771C.792 0 0 .774 0 1.729v20.542
                    C0 23.227.792 24 1.771 24h20.451
                    C23.2 24 24 23.227 24 22.271V1.729
                    C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </a>

            <!-- Email -->
            <a
              href="mailto:sopheaktun.tsp@gmail.com"
              class="text-text-secondary hover:text-primary transition"
              aria-label="Email"
              title="Email"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-7 w-7"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="M22 7l-10 7L2 7"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- ===== RIGHT COLUMN: PROFILE PHOTO ===== -->
        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <!-- Profile Image -->
            <img
              src="/assets/images/tun-sopheak-profile.jpg"
              alt="Tun Sopheak profile photo"
              class="w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96 rounded-full object-cover border-4 border-primary shadow-xl hover:shadow-2xl transition-shadow duration-300"
            />
            <div
              class="absolute -inset-1 rounded-full border-2 border-primary/20 -z-10"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ABOUT ME SECTION                             -->
  <!-- ============================================ -->
  <section id="about" class="py-20 bg-soft-bg transition-colors duration-300">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Section Heading (With Blue Underline) -->
      <div class="text-center mb-12">
        <h2
          class="text-3xl md:text-4xl font-bold text-text-primary inline-block"
        >
          About Me
        </h2>
        <div class="h-1.5 w-12 bg-primary mx-auto mt-2 rounded-full"></div>
      </div>

      <!-- Flex Wrapper: Card and Image side-by-side -->
      <div class="flex flex-col md:flex-row gap-8 md:gap-12 mt-6 items-center">
        <!-- Left Side: The "Card" (Text & Stats) -->
        <div
          class="flex-1 w-full bg-white/5 dark:bg-black/30 backdrop-blur-md border border-white/10 dark:border-gray-700/30 p-6 md:p-8 rounded-3xl shadow-2xl relative overflow-hidden"
        >
          <div
            class="space-y-5 text-text-secondary text-base md:text-lg leading-relaxed"
          >
            <p>
              I'm Sopheak, a fourth-year Computer Science student at RUPP,
              originally from Siem Reap and now living in Phnom Penh for
              university. I'm interested in full-stack web development and enjoy
              learning how frontend, backend, and APIs come together to turn
              ideas into working applications.
            </p>

            <p>
              I've worked on projects ranging from e-commerce interfaces to an
              AI-powered classroom monitoring system, while building my
              foundations in web development, backend development, and
              databases. I'm currently exploring Astro and continuing to grow
              through new projects and hands-on learning.
            </p>

            <p>
              I'm still learning, but that's exactly what keeps me excited about
              development.
            </p>
          </div>

          <!-- Stats Row (Refined & Smaller) -->
          <div
            class="flex flex-col md:flex-row divide-y md:divide-y-0 md:divide-x divide-gray-500/20 text-center pt-5 mt-5 border-t border-gray-500/20 w-full"
          >
            <div class="flex-1 py-2 md:py-1 px-3">
              <p class="text-2xl md:text-3xl font-bold text-primary">
                4th Year
              </p>
              <p
                class="text-xs md:text-xs uppercase tracking-wider text-text-secondary/70 font-medium mt-0.5"
              >
                CS STUDENT
              </p>
            </div>
            <div class="flex-1 py-2 md:py-1 px-3">
              <p class="text-2xl md:text-3xl font-bold text-primary">
                <span id="project-count">0</span>+
              </p>
              <p
                class="text-xs md:text-xs uppercase tracking-wider text-text-secondary/70 font-medium mt-0.5"
              >
                PROJECTS
              </p>
            </div>
            <div class="flex-1 py-2 md:py-1 px-3">
              <p class="text-2xl md:text-3xl font-bold text-primary">Astro</p>
              <p
                class="text-xs md:text-xs uppercase tracking-wider text-text-secondary/70 font-medium mt-0.5"
              >
                CURRENT FOCUS
              </p>
            </div>
          </div>
        </div>

        <!-- Right Side: Profile Photo -->
        <div
          class="w-full md:w-5/12 shrink-0 flex justify-center md:justify-end"
        >
          <div class="relative w-full max-w-sm md:max-w-full group">
            <img
              src="/assets/images/sopheak-dream-img.png"
              alt="Tun Sopheak"
              class="w-full h-auto rounded-2xl shadow-2xl object-cover object-top ring-2 ring-primary/20 transition-all duration-300 group-hover:ring-4 group-hover:ring-primary/40"
            />

            <!-- Mr. Sterling Badge -->
            <div
              class="absolute -bottom-4 right-4 bg-white dark:bg-gray-800 backdrop-blur-md px-4 py-2 rounded-full shadow-xl border border-white/30 dark:border-gray-700/50 flex items-center gap-2.5 transition-transform duration-300 hover:scale-105"
            >
              <span
                class="text-sm font-semibold text-gray-800 dark:text-white tracking-wide"
                >Mr. Sterling</span
              >
              <!-- Icon (Star/Sparkle) -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-yellow-500 dark:text-yellow-400 animate-pulse"
              >
                <path
                  d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                ></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- SKILLS SECTION                               -->
  <!-- ============================================ -->
  <section id="skills" class="py-20 bg-soft-bg transition-colors duration-300">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Section Heading -->
      <div class="text-center mb-12">
        <h2
          class="text-3xl md:text-4xl font-bold text-text-primary inline-block"
        >
          My Skills
        </h2>
        <div class="h-1.5 w-12 bg-primary mx-auto mt-2 rounded-full"></div>
      </div>

      <!-- 6-Card Grid (2 rows of 3 on desktop) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- ============================== -->
        <!-- CARD 1: FRONTEND              -->
        <!-- ============================== -->
        <div
          class="p-5 rounded-2xl border border-white/10 dark:border-gray-700/30 bg-white/5 dark:bg-black/30 backdrop-blur-sm shadow-xl"
        >
          <div
            class="flex justify-between items-center mb-4 border-b border-white/10 dark:border-gray-700/30 pb-3"
          >
            <h3 class="text-lg font-semibold text-primary">Frontend</h3>
            <span
              class="text-xs font-bold text-primary/80 bg-primary/10 px-2 py-0.5 rounded-full"
              >5</span
            >
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <!-- HTML -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg"
                alt="HTML"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] text-text-primary font-medium">HTML</span
              >
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-green-400/20 bg-green-400/10 text-green-400"
                >Inter</span
              >
            </div>
            <!-- CSS -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg"
                alt="CSS"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] text-text-primary font-medium">CSS</span>
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-green-400/20 bg-green-400/10 text-green-400"
                >Inter</span
              >
            </div>
            <!-- JavaScript -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg"
                alt="JavaScript"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] text-text-primary font-medium">JS</span>
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-green-400/20 bg-green-400/10 text-green-400"
                >Inter</span
              >
            </div>
            <!-- Tailwind -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg"
                alt="Tailwind"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] text-text-primary font-medium"
                >Tailwind</span
              >
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-green-400/20 bg-green-400/10 text-green-400"
                >Inter</span
              >
            </div>
            <!-- Astro -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg"
                alt="Astro"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] text-text-primary font-medium"
                >Astro</span
              >
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-yellow-400/20 bg-yellow-400/10 text-yellow-400"
                >Learn</span
              >
            </div>
          </div>
        </div>

        <!-- ============================== -->
        <!-- CARD 2: BACKEND               -->
        <!-- ============================== -->
        <div
          class="p-5 rounded-2xl border border-white/10 dark:border-gray-700/30 bg-white/5 dark:bg-black/30 backdrop-blur-sm shadow-xl"
        >
          <div
            class="flex justify-between items-center mb-4 border-b border-white/10 dark:border-gray-700/30 pb-3"
          >
            <h3 class="text-lg font-semibold text-primary">Backend</h3>
            <span
              class="text-xs font-bold text-primary/80 bg-primary/10 px-2 py-0.5 rounded-full"
              >5</span
            >
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <!-- Java -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg"
                alt="Java"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] text-text-primary font-medium">Java</span
              >
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-green-400/20 bg-green-400/10 text-green-400"
                >Inter</span
              >
            </div>
            <!-- Python -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg"
                alt="Python"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] text-text-primary font-medium"
                >Python</span
              >
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-yellow-400/20 bg-yellow-400/10 text-yellow-400"
                >Learn</span
              >
            </div>
            <!-- FastAPI -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/fastapi/fastapi-original.svg"
                alt="FastAPI"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] text-text-primary font-medium"
                >FastAPI</span
              >
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-yellow-400/20 bg-yellow-400/10 text-yellow-400"
                >Learn</span
              >
            </div>
            <!-- Node.js -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg"
                alt="Node.js"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] text-text-primary font-medium"
                >Node.js</span
              >
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-yellow-400/20 bg-yellow-400/10 text-yellow-400"
                >Learn</span
              >
            </div>
            <!-- REST APIs -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <span
                class="text-2xl mb-1.5 group-hover:scale-110 transition-transform duration-300"
                >🔗</span
              >
              <span class="text-[11px] text-text-primary font-medium"
                >REST APIs</span
              >
              <span
                class="mt-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-sky-400/20 bg-sky-400/10 text-sky-400"
                >Lrn-Int</span
              >
            </div>
          </div>
        </div>

        <!-- ============================== -->
        <!-- CARD 3: DATABASE              -->
        <!-- ============================== -->
        <div
          class="p-5 rounded-2xl border border-white/10 dark:border-gray-700/30 bg-white/5 dark:bg-black/30 backdrop-blur-sm shadow-xl"
        >
          <div
            class="flex justify-between items-center mb-4 border-b border-white/10 dark:border-gray-700/30 pb-3"
          >
            <h3 class="text-lg font-semibold text-primary">Database</h3>
            <span
              class="text-xs font-bold text-primary/80 bg-primary/10 px-2 py-0.5 rounded-full"
              >2</span
            >
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <!-- PostgreSQL -->
            <div
              class="flex flex-col items-center justify-center p-3 rounded-xl bg-black/20 dark:bg-black/40 border border-white/5 hover:border-primary/50 hover:-translate-y-1 transition-all duration-300 group cursor-default"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg"
                alt="PostgreSQL"
                class="w-7 h-7 mb-1.5 group-hover:scale-110 transition-transform duration-300"
