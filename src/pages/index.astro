---
import BaseLayout from "../layouts/BaseLayout.astro";
import T from "../components/T.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SkillCard from "../components/SkillCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ActivityCard from "../components/ActivityCard.astro";
import AchievementCard from "../components/AchievementCard.astro";
import ContactForm from "../components/ContactForm.astro";

import { projects } from "../data/projects";
import { activities } from "../data/activities";
import { achievements } from "../data/achievements";
import { skillGroups, orbitSkills } from "../data/skills";
import { education } from "../data/education";
import { socials, cvFile } from "../data/profile";

// Hero orbit: spread each ring's icons evenly around the circle
const rings = [0, 1].map((ring) => {
  const items = orbitSkills.filter((s) => s.ring === ring);
  return items.map((s, i) => ({ ...s, angle: (360 / items.length) * i }));
});

const sparkles: Record<string, string>[] = [
  { top: "6%", left: "12%", t: "2.8s", dl: "0s" },
  { top: "10%", right: "6%", t: "3.5s", dl: "0.6s" },
  { bottom: "8%", left: "8%", t: "3.2s", dl: "1.2s" },
  { bottom: "12%", right: "9%", t: "4s", dl: "0.3s" },
  { top: "42%", left: "2%", t: "2.5s", dl: "0.9s" },
  { top: "36%", right: "2%", t: "3.8s", dl: "1.5s" },
];
const sparkleStyle = (s: Record<string, string>) =>
  Object.entries(s)
    .map(([k, v]) => (k === "t" ? `--t:${v}` : k === "dl" ? `--dl:${v}` : `${k}:${v}`))
    .join(";");

const heroSocials = socials.filter((s) => s.featured);
---

<BaseLayout title="Tun Sopheak">
  <!-- ============================================ -->
  <!-- HERO                                         -->
  <!-- ============================================ -->
  <section id="hero" class="relative flex min-h-[calc(100svh-4rem)] items-center overflow-hidden py-12 md:py-16">
    <!-- Background video: only fetched on desktop (see script below); a still image everywhere else -->
    <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
      <video
        data-hero-video
        data-src="/assets/videos/khmer-tech-bg.mp4"
        poster="/assets/images/khmer-bg.webp"
        muted
        loop
        playsinline
        preload="none"
        class="h-full w-full object-cover object-center opacity-30 dark:opacity-50"
      ></video>
      <div class="absolute inset-0 bg-gradient-to-r from-bg via-bg/70 to-bg/20"></div>
    </div>

    <div class="container-x relative">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Text -->
        <div class="rounded-2xl border border-border bg-surface/80 p-6 text-center shadow-lg backdrop-blur-md md:p-8 lg:text-left">
          <div class="mb-5 flex justify-center lg:justify-start">
            <span class="inline-flex items-center gap-2 rounded-full border border-green-400/50 bg-green-500/10 px-4 py-1.5 text-sm font-medium text-green-700 dark:text-green-300">
              <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-green-500"></span>
              <T en="Open to Work" km="ត្រៀមខ្លួនទទួលការងារ" />
            </span>
          </div>

          <p class="text-lg text-text-secondary md:text-xl"><T en="Hello, I'm" km="សួស្តី ខ្ញុំគឺ" /></p>
          <h1 class="text-4xl font-bold tracking-tight text-text-primary md:text-6xl lg:text-7xl">Tun Sopheak</h1>

          <p class="mt-3 min-h-[2.5rem] text-2xl font-medium text-primary md:text-3xl">
            <span id="typed-role">Backend Developer</span><span class="cursor-blink" aria-hidden="true">|</span>
          </p>

          <p class="mx-auto mt-6 max-w-lg text-base leading-relaxed text-text-secondary md:text-lg lg:mx-0">
            <T
              en="Building scalable backend systems with Java, Spring Boot, and Python. Passionate about database architecture, API design, and clean, maintainable code."
              km="សាងសង់ប្រព័ន្ធ backend ដែលអាចពង្រីកបាន ដោយប្រើ Java, Spring Boot និង Python។ ស្រឡាញ់ស្ថាបត្យកម្មមូលដ្ឋានទិន្នន័យ ការរចនា API និងកូដស្អាត ងាយថែទាំ។"
            />
          </p>
          <p class="mt-3 text-sm text-text-muted">
            <T
              en="Computer Science Student at RUPP · Phnom Penh, Cambodia"
              km="និស្សិតវិទ្យាសាស្ត្រកុំព្យូទ័រ នៅ RUPP · ភ្នំពេញ កម្ពុជា"
            />
          </p>

          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start">
            <a href="#projects" class="btn btn-primary group/btn !px-7 !py-3">
              <T en="View Projects" km="មើលគម្រោង" />
              <Icon name="arrow" class="h-5 w-5 transition-transform group-hover/btn:translate-x-1" />
            </a>
            <a href={cvFile} download class="btn btn-outline !px-7 !py-3">
              <Icon name="download" class="h-5 w-5" />
              <T en="Download CV" km="ទាញយក CV" />
            </a>
          </div>

          <div class="mt-8 flex items-center justify-center gap-2 lg:justify-start">
            {heroSocials.map((s) => (
              <a
                href={s.href}
                target={s.id === "email" ? undefined : "_blank"}
                rel="noopener noreferrer"
                aria-label={s.label}
                class="grid h-11 w-11 place-items-center rounded-full text-text-secondary transition hover:bg-primary/10 hover:text-primary"
              >
                <Icon name={s.icon} class="h-6 w-6" />
              </a>
            ))}
          </div>
        </div>

        <!-- Solar system -->
        <div class="flex justify-center lg:justify-end">
          <div class="solar" aria-hidden="true">
            <div class="sun-glow"></div>
            <div class="sun-core"></div>

            {rings.map((planets, ring) => (
              <div class:list={["orbit-ring", ring === 0 ? "orbit-ring--outer" : "orbit-ring--inner"]}>
                {planets.map((p) => (
                  <div class="planet" style={`--a:${p.angle}deg`} title={p.name}>
                    <img src={`/assets/icons/tech/${p.icon}.svg`} alt="" width="32" height="32" loading="lazy" decoding="async" />
                  </div>
                ))}
              </div>
            ))}

            <!-- Profile photo = the sun -->
            <div class="absolute inset-[15%] z-20 overflow-hidden rounded-full bg-soft-bg shadow-[0_0_60px_rgba(251,191,36,0.3)] ring-2 ring-primary/70">
              <img
                src="/assets/images/tun-sopheak-profile.webp"
                alt="Tun Sopheak"
                width="560"
                height="700"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>

            {sparkles.map((s, i) => (
              <span class:list={["sparkle", i > 2 && "sparkle--extra"]} style={sparkleStyle(s)}></span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ABOUT                                        -->
  <!-- ============================================ -->
  <section id="about" class="section bg-soft-bg">
    <div class="container-x">
      <SectionHeading en="About Me" km="អំពីខ្ញុំ" />

      <div class="flex flex-col items-center gap-10 md:flex-row md:gap-12">
        <div class="card reveal w-full flex-1 p-6 md:p-8">
          <div class="space-y-5 text-base leading-relaxed text-text-secondary md:text-lg">
            <p>
              <T
                en="I'm Sopheak, a fourth-year Computer Science student at RUPP, originally from Siem Reap and now based in Phnom Penh. I'm passionate about backend development, database architecture, and building scalable systems using Java, Spring Boot, and Python. I love designing efficient APIs, optimizing database performance, and writing clean, maintainable code."
                km="ខ្ញុំគឺ Sopheak ជានិស្សិតឆ្នាំទី៤ ផ្នែកវិទ្យាសាស្ត្រកុំព្យូទ័រ នៅសាកលវិទ្យាល័យភូមិន្ទភ្នំពេញ (RUPP) មានស្រុកកំណើតនៅសៀមរាប ហើយបច្ចុប្បន្នរស់នៅភ្នំពេញ។ ខ្ញុំស្រឡាញ់ការអភិវឌ្ឍ backend ស្ថាបត្យកម្មមូលដ្ឋានទិន្នន័យ និងការសាងសង់ប្រព័ន្ធដែលអាចពង្រីកបាន ដោយប្រើ Java, Spring Boot និង Python។ ខ្ញុំចូលចិត្តរចនា API ដែលមានប្រសិទ្ធភាព បង្កើនដំណើរការមូលដ្ឋានទិន្នន័យ និងសរសេរកូដស្អាត ងាយថែទាំ។"
              />
            </p>
            <p>
              <T
                en="My experience includes building an AI-powered classroom monitoring system and developing e-commerce platforms, which strengthened my skills in backend architecture, API design, and database management. I also have frontend experience with Astro and React, allowing me to build complete, full-stack solutions when needed."
                km="បទពិសោធន៍របស់ខ្ញុំរួមមានការសាងសង់ប្រព័ន្ធត្រួតពិនិត្យថ្នាក់រៀនដោយ AI និងការអភិវឌ្ឍវេទិកាពាណិជ្ជកម្មអេឡិចត្រូនិក ដែលបានពង្រឹងជំនាញរបស់ខ្ញុំលើស្ថាបត្យកម្ម backend ការរចនា API និងការគ្រប់គ្រងមូលដ្ឋានទិន្នន័យ។ ខ្ញុំក៏មានបទពិសោធន៍ផ្នែក frontend ជាមួយ Astro និង React ដែលអនុញ្ញាតឱ្យខ្ញុំសាងសង់ដំណោះស្រាយ full-stack ពេញលេញនៅពេលចាំបាច់។"
              />
            </p>
            <p>
              <T
                en="I'm currently deepening my expertise in Java and Spring Boot while exploring system design, microservices, and cloud deployment — and I'm still learning, which is what drives me."
                km="បច្ចុប្បន្នខ្ញុំកំពុងពង្រឹងជំនាញ Java និង Spring Boot ព្រមទាំងស្វែងយល់ពី system design, microservices និងការ deploy លើ cloud — ហើយខ្ញុំនៅតែបន្តរៀន ដែលជាអ្វីដែលជំរុញខ្ញុំ។"
              />
            </p>
          </div>

          <dl class="mt-6 grid grid-cols-3 divide-x divide-border pt-2 text-center">
            <!-- <dt> (label) comes first in the HTML, as required; flex-col-reverse shows the number on top -->
            <div class="flex flex-col-reverse px-2">
              <dt class="mt-0.5 text-[11px] font-medium uppercase tracking-wider text-text-muted"><T en="CS Student" km="និស្សិត CS" /></dt>
              <dd class="text-xl font-bold text-primary md:text-3xl"><T en="4th Year" km="ឆ្នាំទី ៤" /></dd>
            </div>
            <div class="flex flex-col-reverse px-2">
              <dt class="mt-0.5 text-[11px] font-medium uppercase tracking-wider text-text-muted"><T en="Projects" km="គម្រោង" /></dt>
              <dd class="text-xl font-bold text-primary md:text-3xl"><span id="project-count" data-target={projects.length}>{projects.length}</span></dd>
            </div>
            <div class="flex flex-col-reverse px-2">
              <dt class="mt-0.5 text-[11px] font-medium uppercase tracking-wider text-text-muted"><T en="Backend Focus" km="ផ្តោត Backend" /></dt>
              <dd class="text-xl font-bold text-primary md:text-3xl">Java</dd>
            </div>
          </dl>
        </div>

        <div class="reveal flex w-full shrink-0 justify-center md:w-5/12 md:justify-end" style="--d:120ms">
          <div class="group relative w-full max-w-sm md:max-w-full">
            <img
              src="/assets/images/sopheak-dream-img.webp"
              alt="Tun Sopheak"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
              class="h-auto w-full rounded-2xl object-cover object-top shadow-xl ring-2 ring-primary/20 transition duration-300 group-hover:ring-4 group-hover:ring-primary/40"
            />
            <div class="absolute -bottom-4 right-4 flex items-center gap-2.5 rounded-full border border-border bg-surface px-4 py-2 shadow-xl">
              <span class="text-sm font-semibold text-text-primary">Mr. Sterling</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-pulse text-yellow-500" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- SKILLS (data/skills.js)                      -->
  <!-- ============================================ -->
  <section id="skills" class="section">
    <div class="container-x">
      <SectionHeading en="My Skills" km="ជំនាញរបស់ខ្ញុំ" />
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {skillGroups.map((group, i) => <SkillCard group={group} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- PROJECTS                                     -->
  <!-- ============================================ -->
  <section id="projects" class="section bg-soft-bg">
    <div class="container-x">
      <SectionHeading
        en="Featured Projects"
        km="គម្រោងលេចធ្លោ"
        subEn="A selection of my recent works, from university team projects to personal full-stack applications, demonstrating my growth as a backend-focused developer."
        subKm="ការជ្រើសរើសស្នាដៃថ្មីៗរបស់ខ្ញុំ ពីគម្រោងក្រុមនៅសាកលវិទ្យាល័យ ដល់កម្មវិធី full-stack ផ្ទាល់ខ្លួន ដែលបង្ហាញពីការរីកចម្រើនរបស់ខ្ញុំជាអ្នកអភិវឌ្ឍផ្តោតលើ backend។"
      />
      <div class="card-grid">
        {projects.slice(0, 3).map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
      <div class="mt-12 text-center">
        <a href="/projects/" class="btn btn-primary group/btn !px-7 !py-3">
          <T en="View All Projects" km="មើលគម្រោងទាំងអស់" />
          <Icon name="arrow" class="h-5 w-5 transition-transform group-hover/btn:translate-x-1" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- EDUCATION (data/education.js)                -->
  <!-- ============================================ -->
  <section id="education" class="section">
    <div class="container-x max-w-5xl">
      <SectionHeading en="My Education Journey" km="ដំណើរសិក្សារបស់ខ្ញុំ" />

      <div class="relative">
        <!-- the line: left on mobile, centred on desktop (a sibling of the list, since <ol> may only contain <li>) -->
        <span class="absolute bottom-0 left-4 top-0 w-px -translate-x-1/2 bg-border md:left-1/2" aria-hidden="true"></span>

      <ol class="relative">
        {education.map((item, i) => {
          const km = item.km;
          const right = i % 2 === 1;
          return (
            <li class:list={["reveal relative pb-8 pl-12 last:pb-0 md:w-1/2 md:pb-12", right ? "md:ml-auto md:pl-12" : "md:pr-12 md:pl-0"]}>
              <span
                class:list={[
                  "absolute left-4 top-7 h-3.5 w-3.5 -translate-x-1/2 rounded-full border-2 border-primary bg-bg md:left-auto",
                  right ? "md:left-0" : "md:right-0 md:translate-x-1/2",
                  item.active && "ring-4 ring-primary/20",
                ]}
                aria-hidden="true"
              ></span>

              <div class:list={["card p-5 md:p-6", item.active && "!border-primary/50"]}>
                <div class="mb-4 flex items-start justify-between gap-3">
                  <span class={`grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br ${item.gradient} p-2.5 shadow-lg`}>
                    <img src={`/assets/icons/education/${item.icon}.svg`} alt="" width="28" height="28" loading="lazy" class="h-full w-full object-contain" />
                  </span>
                  <div class="flex flex-wrap items-center justify-end gap-2">
                    <span class="text-sm font-semibold text-primary">{item.years}</span>
                    {item.active && (
                      <span class="inline-flex items-center gap-1.5 rounded-full bg-green-500/15 px-2.5 py-1 text-[11px] font-bold text-green-700 dark:text-green-400">
                        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500"></span>
                        <T en="Active" km="កំពុងសិក្សា" />
                      </span>
                    )}
                  </div>
                </div>

                <h3 class="text-lg font-bold text-text-primary md:text-xl"><T en={item.title} km={km?.title} /></h3>
                <p class="mt-1 text-sm font-medium text-text-secondary md:text-base"><T en={item.school} km={km?.school} /></p>
                <p class="mt-2 flex items-center gap-1.5 text-xs text-text-muted">
                  <Icon name="map-pin" class="h-3.5 w-3.5 text-primary" />
                  <T en={item.location} km={km?.location} />
                </p>

                <div class="mt-3 flex flex-wrap gap-2">
                  {item.tags.map((tag, t) => <span class="chip"><T en={tag} km={km?.tags?.[t]} /></span>)}
                </div>

                {item.description && (
                  <p class="mt-4 text-sm leading-relaxed text-text-secondary">
                    <T en={item.description} km={km?.description} />
                  </p>
                )}
              </div>
            </li>
          );
        })}
      </ol>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ACTIVITIES                                  -->
  <!-- ============================================ -->
  <section id="activities" class="section bg-soft-bg">
    <div class="container-x">
      <SectionHeading
        en="Activities & Involvement"
        km="សកម្មភាព និងការចូលរួម"
        subEn="Beyond coding — leadership, volunteering, and community involvement."
        subKm="ក្រៅពីកូដ — ភាពជាអ្នកដឹកនាំ ការស្ម័គ្រចិត្ត និងការចូលរួមក្នុងសហគមន៍។"
      />
      <div class="card-grid">
        {activities.slice(0, 3).map((activity, i) => <ActivityCard activity={activity} index={i} />)}
      </div>
      <div class="mt-12 text-center">
        <a href="/activities/" class="btn btn-primary group/btn !px-7 !py-3">
          <T en="View All Activities" km="មើលសកម្មភាពទាំងអស់" />
          <Icon name="arrow" class="h-5 w-5 transition-transform group-hover/btn:translate-x-1" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ACHIEVEMENTS                                 -->
  <!-- ============================================ -->
  <section id="achievements" class="section">
    <div class="container-x">
      <SectionHeading
        en="Achievements"
        km="សមិទ្ធផល"
        subEn="Certificates, awards, scholarships, and recognitions I've earned."
        subKm="វិញ្ញាបនបត្រ ពានរង្វាន់ អាហារូបករណ៍ និងការទទួលស្គាល់ដែលខ្ញុំទទួលបាន។"
      />
