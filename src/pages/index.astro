<script>
  // Form handling via fetch (Replaces the default Formspree redirect)
    async function handleSubmit(event: Event) {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const formData = new FormData(form);
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitButton.innerHTML;
    
    submitButton.disabled = true;
    submitButton.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/></svg> Sending...`;

    try {
      // Uses your local API endpoint instead of Formspree
      const response = await fetch("/api/contact", {
        method: "POST",
        body: formData,
      });

      if (response.ok) {
        showToast("Message sent successfully.", "Thank you for reaching out. I'll get back to you as soon as possible.", "green");
        form.reset(); 
      } else {
        const errorData = await response.json();
        showToast("Something went wrong!", errorData.error || "Please try again later.", "red");
      }
    } catch (error) {
      showToast("Network error", "Please check your internet connection and try again.", "red");
    } finally {
      submitButton.disabled = false;
      submitButton.innerHTML = originalText;
    }
  }

    // CUSTOM TOAST NOTIFICATION (Fixed Types)
  function showToast(title: string, message: string, type: "green" | "red" = "green") {
    const existingToasts = document.querySelectorAll('#toast-container .toast-item');
    existingToasts.forEach(el => el.remove());

    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'fixed top-4 right-4 z-50 flex flex-col gap-2 items-end pointer-events-none';
      document.body.appendChild(container);
    }

    const toast = document.createElement('div');
    
    const colors = type === "green" 
      ? { bg: 'bg-green-50 dark:bg-green-900/30', border: 'border-green-200/50 dark:border-green-800/50', text: 'text-green-800 dark:text-green-200', subtext: 'text-green-700/70 dark:text-green-300/70', icon: 'text-green-600 dark:text-green-400' }
      : { bg: 'bg-red-50 dark:bg-red-900/30', border: 'border-red-200/50 dark:border-red-800/50', text: 'text-red-800 dark:text-red-200', subtext: 'text-red-700/70 dark:text-red-300/70', icon: 'text-red-600 dark:text-red-400' };

    toast.className = `toast-item pointer-events-auto w-full max-w-sm overflow-hidden rounded-xl ${colors.bg} border ${colors.border} shadow-xl p-4 flex items-start gap-3 transform translate-x-full opacity-0 transition-all duration-300`;

    toast.innerHTML = `
      <div class="flex-shrink-0 mt-0.5">
        <svg class="h-5 w-5 ${colors.icon}" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="flex-1 pt-0.5">
        <p class="text-sm font-medium ${colors.text}">${title}</p>
        <p class="mt-1 text-sm ${colors.subtext}">${message}</p>
      </div>
      <button onclick="this.closest('.toast-item').remove()" class="flex-shrink-0 ${colors.subtext} hover:${colors.text}">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    `;

    container.appendChild(toast);

    setTimeout(() => toast.classList.remove('translate-x-full', 'opacity-0'), 50);
    setTimeout(() => {
      toast.classList.add('translate-x-full', 'opacity-0');
      setTimeout(() => toast.remove(), 300);
    }, 5000);
  }

  (window as any).handleSubmit = handleSubmit;
</script>

