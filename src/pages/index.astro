<script>
  import { getLang } from "../scripts/ui";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---------------------------------------------------------------
  // Typewriter (restarts when the language changes)
  // ---------------------------------------------------------------
  const ROLES = {
    en: ["Backend Developer", "Java Developer", "Spring Boot Developer"],
    km: ["អ្នកអភិវឌ្ឍ Backend", "អ្នកអភិវឌ្ឍ Java", "អ្នកអភិវឌ្ឍ Spring Boot"],
  };
  const typed = document.getElementById("typed-role");
  let timer: number | undefined;

  const segmenter = "Segmenter" in Intl ? new Intl.Segmenter(undefined, { granularity: "grapheme" }) : null;
  const splitGraphemes = (text: string): string[] =>
    segmenter ? Array.from(segmenter.segment(text), (s) => s.segment) : Array.from(text);

  function typewriter(): void {
    if (!typed) return;
    window.clearTimeout(timer);
    const roles = ROLES[getLang()];
    if (reduceMotion) {
      typed.textContent = roles[0];
      return;
    }
    let role = 0;
    let chars = 0;
    let deleting = false;

    const tick = () => {
      const text = roles[role];
      chars += deleting ? -1 : 1;
      // Split by grapheme so Khmer letter clusters are never cut in half
      const letters = splitGraphemes(text);
      typed.textContent = letters.slice(0, chars).join("");

      let delay = deleting ? 45 : 90;
      if (!deleting && chars === letters.length) {
        deleting = true;
        delay = 1800;
      } else if (deleting && chars === 0) {
        deleting = false;
        role = (role + 1) % roles.length;
        delay = 450;
      }
      timer = window.setTimeout(tick, delay);
    };
    typed.textContent = "";
    tick();
  }
  typewriter();
  document.addEventListener("langchange", typewriter);

  // ---------------------------------------------------------------
  // Count-up for the projects stat
  // ---------------------------------------------------------------
  const counter = document.getElementById("project-count");
  if (counter && !reduceMotion && "IntersectionObserver" in window) {
    const target = Number(counter.dataset.target) || 0;
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min((now - start) / 800, 1);
          counter.textContent = String(Math.round((1 - Math.pow(1 - p, 3)) * target));
          if (p < 1) requestAnimationFrame(step);
        };
        counter.textContent = "0";
        requestAnimationFrame(step);
      },
      { threshold: 0.4 },
    );
    io.observe(counter);
  }
</script>
