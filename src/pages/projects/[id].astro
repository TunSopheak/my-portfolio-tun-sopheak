---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";
import T from "../../components/T.astro";
import Icon from "../../components/Icon.astro";
import { projects } from "../../data/projects";

// One page is generated for every project in data/projects.js
export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const km = project.km ?? {};
const h2 = "mb-4 inline-block border-b border-border pb-3 text-2xl font-bold text-text-primary";
const label = "mb-1 text-xs font-semibold uppercase tracking-wider text-text-muted";
---

<BaseLayout title={`${project.title} — Tun Sopheak`} description={project.description}>
  <section class="section min-h-screen bg-soft-bg">
    <div class="container-x">
      <BackLink href="/projects/" en="Back to All Projects" km="ត្រឡប់ទៅគម្រោងទាំងអស់" />

      <div class="flex flex-col gap-8">
        <div class="flex flex-col justify-between gap-3 border-b border-border pb-6 md:flex-row md:items-end">
          <h1 class="text-3xl font-bold tracking-tight text-text-primary md:text-5xl">
            <T en={project.title} km={km.title} />
          </h1>
          <span class="shrink-0 text-lg font-medium text-primary">{project.year}</span>
        </div>

        <div class="card relative aspect-video overflow-hidden bg-primary/5">
          <div class="absolute inset-0 grid place-items-center text-sm font-medium text-text-muted">
            <T en="Project image coming soon" km="រូបភាពគម្រោងនឹងដាក់បង្ហាញឆាប់ៗនេះ" />
          </div>
          <img src={project.image} alt={project.title} width="1200" height="750" decoding="async" class="relative h-full w-full object-cover" onerror="this.remove()" />
        </div>

        <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-16">
          <div class="flex flex-col gap-10 lg:col-span-2">
            <div>
              <h2 class={h2}><T en="Overview" km="ទិដ្ឋភាពទូទៅ" /></h2>
              <p class="text-base leading-relaxed text-text-secondary">
                <T
                  en={project.overview ?? "No overview provided yet."}
                  km={km.overview ?? (project.overview ? undefined : "មិនទាន់មានទិដ្ឋភាពទូទៅនៅឡើយទេ។")}
                />
              </p>
            </div>

            {project.features && project.features.length > 0 && (
              <div>
                <h2 class={h2}><T en="Key Features" km="មុខងារសំខាន់ៗ" /></h2>
                <ul class="list-inside list-disc space-y-3 text-base leading-relaxed text-text-secondary marker:text-primary">
                  {project.features.map((feature, i) => (
                    <li><T en={feature} km={km.features?.[i]} /></li>
                  ))}
                </ul>
              </div>
            )}

            {project.tags.length > 0 && (
              <div>
                <h2 class={h2}><T en="Technologies Used" km="បច្ចេកវិទ្យាដែលបានប្រើ" /></h2>
                <div class="flex flex-wrap gap-2.5">
                  {project.tags.map((tag) => <span class="chip !px-4 !py-2 !text-sm">{tag}</span>)}
                </div>
              </div>
            )}
          </div>

          <aside class="lg:col-span-1">
            <div class="card flex flex-col gap-6 p-6 lg:sticky lg:top-24">
              <h3 class="border-b border-border pb-3 text-xl font-bold text-text-primary"><T en="Project Info" km="ព័ត៌មានគម្រោង" /></h3>

              <div>
                <p class={label}><T en="Type" km="ប្រភេទ" /></p>
                <p class="font-medium text-text-secondary"><T en={project.type} km={km.type} /></p>
              </div>

              <div>
                <p class={label}><T en="Live Site" km="គេហទំព័រផ្ទាល់" /></p>
                {project.liveDemo ? (
                  <a href={project.liveDemo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline">
                    <Icon name="external" class="h-4 w-4" />
                    <T en="Visit Live Site" km="ចូលមើលគេហទំព័រ" />
                  </a>
                ) : (
                  <p class="text-sm italic text-text-muted"><T en="Not available" km="មិនមាន" /></p>
                )}
              </div>

              <div>
                <p class={label}><T en="Source Code" km="កូដប្រភព" /></p>
                {project.github ? (
                  <a href={project.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-text-secondary transition hover:text-primary">
                    <Icon name="github" class="h-4 w-4" />
                    <T en="View on GitHub" km="មើលនៅ GitHub" />
                  </a>
                ) : (
                  <p class="text-sm italic text-text-muted"><T en="Private / Not available" km="ឯកជន / មិនទាន់មាន" /></p>
                )}
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
