---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
---

<BaseLayout title="All Projects — Tun Sopheak" description="All software projects by Tun Sopheak: backend systems, web apps and mobile apps.">
  <section class="section min-h-screen bg-soft-bg">
    <div class="container-x">
      <BackLink href="/#projects" en="Back to Home" km="ត្រឡប់ទៅទំព័រដើម" />
      <SectionHeading as="h1" en="All Projects" km="គម្រោងទាំងអស់" />

      <div class="card-grid">
        {projects.map((project, i) => <ProjectCard project={project} allTags showType index={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>
