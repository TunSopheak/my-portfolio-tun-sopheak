---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import AchievementCard from "../../components/AchievementCard.astro";
import { achievements } from "../../data/achievements";
---

<BaseLayout title="All Achievements — Tun Sopheak" description="Certificates, awards and recognitions earned by Tun Sopheak.">
  <section class="section min-h-screen bg-soft-bg">
    <div class="container-x">
      <BackLink href="/#achievements" en="Back to Home" km="ត្រឡប់ទៅទំព័រដើម" />
      <SectionHeading
        as="h1"
        en="All Achievements"
        km="សមិទ្ធផលទាំងអស់"
        subEn="Certificates, awards, scholarships, and recognitions I've earned."
        subKm="វិញ្ញាបនបត្រ ពានរង្វាន់ អាហារូបករណ៍ និងការទទួលស្គាល់ដែលខ្ញុំទទួលបាន។"
      />

      <div class="card-grid">
        {achievements.map((achievement, i) => <AchievementCard achievement={achievement} index={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>
