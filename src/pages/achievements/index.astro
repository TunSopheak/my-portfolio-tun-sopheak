---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { achievements } from "../../data/achievements";
---

<BaseLayout title="All Achievements — Tun Sopheak">
  <section class="py-20 bg-soft-bg transition-colors duration-300 min-h-screen">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      
      <!-- Back to Home -->
      <div class="flex items-center gap-1.5 mb-6">
        <a href="/#achievements" class="text-sm text-text-secondary hover:text-primary transition flex items-center">
          <span class="text-xl mr-1">&larr;</span> Back to Home
        </a>
      </div>

      <!-- Section Heading -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-5xl font-bold text-text-primary">All Achievements</h1>
        <div class="h-1.5 w-12 bg-primary mx-auto mt-2 rounded-full"></div>
        <p class="text-text-secondary text-base mt-4 max-w-2xl mx-auto">
          Certificates, awards, scholarships, and recognitions I've earned.
        </p>
      </div>

      <!-- Achievements Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {achievements.slice().map((achievement) => {
          return (
            <div class="group bg-white/5 dark:bg-black/30 backdrop-blur-md border border-white/10 dark:border-gray-700/30 rounded-2xl p-4 md:p-5 shadow-xl hover:shadow-2xl hover:-translate-y-2 hover:border-primary/40 transition-all duration-300 flex flex-col gap-4">
              
              <!-- Thumbnail Image -->
              <div class="relative aspect-[16/10] bg-gradient-to-br from-primary/10 to-primary/5 rounded-xl overflow-hidden shrink-0">
                <img
                  src={achievement.image}
                  alt={achievement.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
                />
                <div class="hidden absolute inset-0 flex items-center justify-center text-primary/40">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <span class="absolute top-3 right-3 bg-primary/80 text-white text-[10px] font-semibold px-2.5 py-1 rounded-full backdrop-blur-sm">
                  {achievement.type}
                </span>
              </div>

              <!-- Content -->
              <div class="flex flex-col flex-1 gap-3">
                <div>
                  <h3 class="text-xl font-bold text-text-primary leading-tight">{achievement.title}</h3>
                  <p class="text-sm text-primary/80 font-medium mt-1">{achievement.year}</p>
                </div>

                <p class="text-text-secondary text-sm leading-relaxed flex-1">
                  {achievement.description}
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2">
                  {achievement.tags.slice(0, 3).map((tag) => (
                    <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-1 text-[10px] font-medium text-primary ring-1 ring-inset ring-primary/20">
                      {tag}
                    </span>
                  ))}
                </div>

                <!-- View Certificate OR Pending Badge -->
                <div class="flex items-center mt-4 pt-4 border-t border-white/10 dark:border-gray-700/30">
                  {achievement.certificate ? (
                    <button
                      onclick={`openCertificate('${achievement.certificate}')`}
                      class="inline-flex items-center justify-center gap-2 rounded-full bg-primary text-white px-6 py-2.5 text-sm font-medium hover:bg-primary-hover shadow-lg hover:shadow-primary/30 hover:-translate-y-0.5 transition-all duration-300 group w-full cursor-pointer"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                      View Certificate
                    </button>
                  ) : (
                    <span class="inline-flex items-center justify-center gap-2 rounded-full bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 border border-yellow-500/30 px-6 py-2.5 text-sm font-medium w-full">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Certificate Pending
                    </span>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>
</BaseLayout>

<!-- ============================================ -->
<!-- SIMPLE SCRIPT – Opens Certificates in New Tab -->
<!-- ============================================ -->
<script>
  function openCertificate(url: string): void {
    if (!url) return;
    window.open(url, '_blank');
  }

  // Make function globally accessible for inline onclick
  (window as any).openCertificate = openCertificate;
</script>